# Copia este archivo como ".env" (en la carpeta donde ejecutes la aplicación) y rellena lo que necesites.
#   cp .env.example .env
# El archivo .env NUNCA debe subirse a git (contiene contraseñas).
#
# Orden de prioridad:  opciones de la línea de comandos  >  lo que eliges en «Conexión» dentro de la app
#                      >  este archivo / variables de entorno  >  valores por defecto
# Las contraseñas y credenciales de AWS solo se leen de aquí (o del perfil de AWS); la aplicación nunca las guarda.

# ───────── Modo de funcionamiento ─────────
# demo    → datos de ejemplo en tu computadora, no necesita AWS ni MySQL (por defecto)
# directo → DynamoDB + 2 bases MySQL (solo para desarrollo; ver README, «Seguridad»)
# api     → tu backend Python por HTTP
MKT_MODO=demo

# ───────── Modo demo ─────────
# MKT_DEMO_PRODUCTOS=17000

# ───────── Modo api ─────────
# MKT_API_URL=http://localhost:8000
# MKT_API_TIMEOUT=15

# ───────── Modo directo: DynamoDB (4 tablas: categorias, productos, variantes_producto, resenas) ─────────
# Credenciales: las normales de AWS. Elige UNA forma:
#   a) un perfil:          AWS_PROFILE=mi-perfil
#   b) variables:          AWS_ACCESS_KEY_ID=...   AWS_SECRET_ACCESS_KEY=...   (AWS_SESSION_TOKEN=... si son temporales)
#   c) un rol de IAM (EC2/ECS/Lambda): no pongas nada
AWS_REGION=us-east-1
# DynamoDB Local o un emulador (déjalo vacío para usar AWS de verdad):
# MKT_DYNAMO_ENDPOINT=http://localhost:8000
# Prefijo opcional para los nombres de tabla (dev_ → dev_productos). Útil para separar entornos en una misma cuenta:
# MKT_DYNAMO_PREFIJO=

# ───────── Modo directo: MySQL #1 — usuarios y pagos ─────────
# Forma corta (una URL de SQLAlchemy):
# MKT_USUARIOS_URL=mysql+pymysql://usuario:contraseña@host:3306/mkt_usuarios?charset=utf8mb4
# …o por partes:
MKT_USUARIOS_HOST=127.0.0.1
MKT_USUARIOS_PORT=3306
MKT_USUARIOS_DB=mkt_usuarios
MKT_USUARIOS_USER=root
MKT_USUARIOS_PASSWORD=
# Para RDS/Aurora con TLS: ruta al certificado de la CA (por ejemplo global-bundle.pem de AWS)
# MKT_USUARIOS_SSL_CA=

# ───────── Modo directo: MySQL #2 — operaciones (carritos, detalle_carrito, pedidos, detalle_pedido) ─────────
# MKT_OPS_URL=mysql+pymysql://usuario:contraseña@host:3306/mkt_operaciones?charset=utf8mb4
MKT_OPS_HOST=127.0.0.1
MKT_OPS_PORT=3306
MKT_OPS_DB=mkt_operaciones
MKT_OPS_USER=root
MKT_OPS_PASSWORD=
# MKT_OPS_SSL_CA=

# ───────── Otros ─────────
# Costo de bcrypt (mayor = más seguro y más lento). 12 es un buen valor de producción.
# MKT_BCRYPT_ROUNDS=12
# Productos que se piden por «página» al desplazarse por el catálogo
# MKT_TAMANO_PAGINA=24
